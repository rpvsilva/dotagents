{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Only the remote runner image's pins (remote/runner/Dockerfile): the node base image digest and Claude Code, in one weekly PR.",
  "extends": ["config:recommended"],
  "enabledManagers": ["dockerfile", "custom.regex"],
  "timezone": "Europe/Lisbon",
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "3 days",
  "semanticCommits": "enabled",
  "customManagers": [
    {
      "customType": "regex",
      "description": "ARG pins marked `# renovate: datasource=<x> depName=<y>` on the line above.",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nARG \\S+?_VERSION=(?<currentValue>\\S+)"]
    }
  ],
  "packageRules": [
    {
      "matchFileNames": ["remote/runner/**"],
      "groupName": "runner image",
      "commitMessageTopic": "the runner image",
      "semanticCommitType": "chore",
      "semanticCommitScope": "remote"
    }
  ]
}
