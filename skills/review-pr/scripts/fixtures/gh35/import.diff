+    assert run(cli, "import", "--format", "md", str(write_md(tmp_path, text))) == ["imported 2, skipped 2 duplicates, ignored 0 lines"]
+    assert [i.title for i in load(todo_path)] == ["milk", "tea", "tea", "eggs"]
+
+
+def test_importing_the_same_md_file_twice_adds_nothing_the_second_time(cli, tmp_path, todo_path):
