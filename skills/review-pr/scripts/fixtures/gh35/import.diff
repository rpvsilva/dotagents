+
+def test_import_md_ignores_a_checkbox_with_no_title(cli, tmp_path, todo_path):
+    assert run(cli, "import", "--format", "md", str(write_md(tmp_path, "- [ ] \n- [x]\n- [ ] ok\n"))) == [
+        "imported 1, skipped 0 duplicates, ignored 2 lines"
