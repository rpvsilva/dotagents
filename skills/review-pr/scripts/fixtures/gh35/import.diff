diff --git a/README.md b/README.md
+++ b/README.md
+todo import [--format json|md] FILE   # add the items of a JSON file or a Markdown checklist, see Import
+### Import
+
+`todo import [--format json|md] FILE` adds the items of FILE to the todo file in one save and prints `imported N, skipped M duplicates` (the Markdown form adds `, ignored K lines`). `--format` is `json` by default.
+
+```
+$ todo import tasks.json
+imported 5, skipped 0 duplicates
+$ todo import --format md notes.md
+imported 4, skipped 1 duplicates, ignored 4 lines
+```
+
+**JSON.** FILE is a list of items shaped like the todo file (`id` and `title` are required). Every row goes through the checks a load applies, so one bad row refuses the whole file and nothing is imported.
+
+- Imported items get new ids above every id in the todo file, the archive, the trash and the undo history, in file order. The ids in the file are only labels for each other.
+- A file that repeats an id exits 2 (`rep.json: repeated id 1`).
+- `parent` and `blocked_on` follow the new ids when they name another item in the file, and are dropped when they do not. A row that names itself as its parent or its blocker is refused.
+- Each series in the file (rows sharing a `series_id`) gets one fresh series id, so an imported series never merges with one already in the todo file.
+- Kept as written: title, tags, priority, done state, due date and time, recurrence rule, snooze, doing, project, estimate, notes, focus time and the done-time priority. A row with `due_time` and no `due` is refused (exit 2). `doing` is ignored on a done item.
+- `updated_at` is renewed (an import always wins a later sync) and `created_on` is today.
+- A done item keeps its `done_on`, so `todo streak` counts it on its real day. A `done_on` after tomorrow is capped at tomorrow, as on load. A done row with no `done_on` gets the local date of its `updated_at`; with neither, it counts on the day of the import.
+
+**Markdown.** Each line `- [ ] title` or `* [ ] title` is an open item, and `- [x] title` or `- [X] title` a done one, with `done_on` set to today. A line may be indented. A line that ends in CRLF is accepted: lines split on `\n` only, so a form feed or U+2028 stays in the title. Ids are new ones, in file order. Nothing else is read: no dates, tags or priorities.
+
+- `ignored K` counts the lines that are not blank and are not a checkbox with a title: other text, `+ [ ]` lines, and checkboxes with an empty title.
+- A file that is not UTF-8 text (or holds a NUL) exits 2.
+
+**Both formats.**
+
+- A duplicate is an item with the same title (compared exactly after non-printable characters, such as control codes and newlines, become `?`, so case and spaces matter; JSON titles are not trimmed, Markdown titles lose leading and trailing whitespace) and the same due date as an item already in the todo file, or as an earlier item in the file. It is skipped and counted. Importing the same file twice therefore imports nothing the second time. A skipped item stands for the one it repeats: `parent` and `blocked_on` that named it point at that item.
+- A file with more than 84,307 items (the most a 16 MiB todo file can hold) exits 2 and nothing is imported. A file under that cap can still exit 1 when the todo file plus the import would exceed 16 MiB; nothing is saved then.
+- When no id is free (ids go up to 9007199254740992), it exits 2 and nothing is saved.
+- A missing or unreadable FILE, a bad value, or an unknown `--format` exits 2. Nothing is written unless every row passes. The trash and the archive are untouched.
+
diff --git a/tests/cli/test_cli_import.py b/tests/cli/test_cli_import.py
+++ b/tests/cli/test_cli_import.py
+import json
+from datetime import date, datetime, timedelta, timezone
+
+import pytest
+
+from todo.storage import JsonStore
+from todo.storage.model import done_date
+from todo.storage.side_files import SideFiles
+
+TODAY = date(2026, 11, 6)
+NOW = datetime(2026, 11, 6, 10, 0)
+
+
+def run(cli, *argv):
+    return cli(*argv, today=TODAY, now=NOW)
+
+
+def fail(cli, capsys, code, *argv):
+    with pytest.raises(SystemExit) as exc:
+        run(cli, *argv)
+    assert exc.value.code == code
+    return capsys.readouterr().err
+
+
+@pytest.fixture
+def todo_path(tmp_path):
+    return tmp_path / "todo.json"
+
+
+def load(todo_path):
+    return JsonStore(todo_path, today=lambda: TODAY).load()
+
+
+def write_import(tmp_path, rows, name="in.json"):
+    path = tmp_path / name
+    path.write_text(rows if isinstance(rows, str) else json.dumps(rows))
+    return path
+
+
+def test_import_adds_items_with_new_ids_above_the_todo_file(cli, tmp_path, todo_path):
+    run(cli, "add", "milk")
+    path = write_import(tmp_path, [{"id": 1, "title": "eggs"}, {"id": 7, "title": "bread", "due": "2026-12-01"}])
+    assert run(cli, "import", str(path)) == ["imported 2, skipped 0 duplicates"]
+    assert [(i.id, i.title) for i in load(todo_path)] == [(1, "milk"), (2, "eggs"), (3, "bread")]
+
+
+def test_import_keeps_the_item_fields(cli, tmp_path, todo_path):
+    row = {
+        "id": 4, "title": "report", "due": "2026-12-01", "due_time": "09:30", "tags": ["work"], "priority": "high",
+        "project": "q4", "estimate": 90, "snoozed_until": "2026-11-20", "doing": True,
+        "notes": [{"at": "2026-11-01T10:00:00+00:00", "text": "draft"}], "focus": [{"on": "2026-11-02", "minutes": 25}],
+    }
+    run(cli, "import", str(write_import(tmp_path, [row])))
+    (item,) = load(todo_path)
+    assert (item.title, item.due, str(item.due_time), item.tags, item.priority) == ("report", date(2026, 12, 1), "09:30:00", ["work"], "high")
+    assert (item.project, item.estimate, item.snoozed_until, item.doing) == ("q4", 90, date(2026, 11, 20), True)
+    assert [n.text for n in item.notes] == ["draft"] and item.focus[0].minutes == 25
+
+
+def test_import_stamps_created_on_today_and_updated_at_now(cli, tmp_path, todo_path):
+    row = {"id": 1, "title": "old", "created_on": "2020-01-01", "updated_at": "2020-01-01T00:00:00+00:00"}
+    run(cli, "import", str(write_import(tmp_path, [row])))
+    (item,) = load(todo_path)
+    assert item.created_on == TODAY
+    assert item.updated_at.year >= 2026
+
+
+def test_import_keeps_done_items_and_their_done_on(cli, tmp_path, todo_path):
+    row = {"id": 1, "title": "paid", "done": True, "done_on": "2026-10-20", "done_priority": "high"}
+    run(cli, "import", str(write_import(tmp_path, [row])))
+    (item,) = load(todo_path)
+    assert (item.done, item.done_on, item.done_priority) == (True, date(2026, 10, 20), "high")
+
+
+def test_import_caps_a_future_done_on_as_a_load_does(cli, tmp_path, todo_path):
+    row = {"id": 1, "title": "paid", "done": True, "done_on": "2099-01-01"}
+    assert run(cli, "import", str(write_import(tmp_path, [row]))) == ["imported 1, skipped 0 duplicates"]
+    assert load(todo_path)[0].done_on == TODAY + timedelta(days=1)
+
+
+def test_import_remaps_parent_and_blocked_on_inside_the_file(cli, tmp_path, todo_path):
+    run(cli, "add", "milk")
+    rows = [
+        {"id": 10, "title": "parent"},
+        {"id": 20, "title": "child", "parent": 10, "blocked_on": [10, 99]},
+        {"id": 30, "title": "orphan", "parent": 99},
+    ]
+    run(cli, "import", str(write_import(tmp_path, rows)))
+    items = {i.title: i for i in load(todo_path)}
+    assert items["parent"].id == 2
+    assert (items["child"].parent, items["child"].blocked_on) == (2, [2])
+    assert items["orphan"].parent is None
+
+
+def test_import_does_not_point_a_reference_at_an_existing_item(cli, tmp_path, todo_path):
+    run(cli, "add", "milk")  # id 1; the file's parent 1 names a file row that does not exist
+    run(cli, "import", str(write_import(tmp_path, [{"id": 5, "title": "x", "parent": 1, "blocked_on": [1]}])))
+    item = load(todo_path)[1]
+    assert (item.parent, item.blocked_on) == (None, [])
+
+
+def test_import_gives_each_source_series_one_fresh_series_id(cli, tmp_path, todo_path):
+    rows = [
+        {"id": 1, "title": "water", "due": "2026-11-05", "every": "day", "series_id": "aaa", "occurrence": 1, "done": True},
+        {"id": 2, "title": "water", "due": "2026-11-06", "every": "day", "series_id": "aaa", "occurrence": 2},
+        {"id": 3, "title": "gym", "due": "2026-11-06", "every": "week", "series_id": "bbb", "occurrence": 1},
+        {"id": 4, "title": "plain"},
+    ]
+    run(cli, "import", str(write_import(tmp_path, rows)))
+    items = load(todo_path)
+    assert items[0].series_id == items[1].series_id
+    assert items[2].series_id not in (items[0].series_id, None)
+    assert "aaa" not in (items[0].series_id, items[1].series_id) and "bbb" != items[2].series_id
+    assert items[3].series_id is None
+    assert (items[0].occurrence, items[1].occurrence) == (1, 2)
+
+
+def test_import_skips_items_already_in_the_todo_file(cli, tmp_path, todo_path):
+    run(cli, "add", "Milk", "--due", "2026-12-01")
+    rows = [
+        {"id": 1, "title": "Milk", "due": "2026-12-01"},  # same title and due
+        {"id": 2, "title": "Milk", "due": "2026-12-02"},  # other due: kept
+        {"id": 3, "title": "Milk"},  # no due: kept
+    ]
+    assert run(cli, "import", str(write_import(tmp_path, rows))) == ["imported 2, skipped 1 duplicates"]
+    assert len(load(todo_path)) == 3
+
+
+def test_import_keeps_titles_that_differ_in_case_or_spacing(cli, tmp_path, todo_path):
+    run(cli, "add", "buy milk")
+    rows = [{"id": 1, "title": "Buy Milk"}, {"id": 2, "title": "buy  milk"}, {"id": 3, "title": "buy milk "}]
+    assert run(cli, "import", str(write_import(tmp_path, rows))) == ["imported 3, skipped 0 duplicates"]
+
+
+def test_import_skips_a_repeat_inside_the_file(cli, tmp_path, todo_path):
+    run(cli, "add", "milk")
+    rows = [{"id": 1, "title": "eggs"}, {"id": 2, "title": "eggs"}, {"id": 3, "title": "toast", "parent": 2}]
+    assert run(cli, "import", str(write_import(tmp_path, rows))) == ["imported 2, skipped 1 duplicates"]
+    items = load(todo_path)[1:]
+    assert [(i.id, i.title) for i in items] == [(2, "eggs"), (3, "toast")]
+    assert items[1].parent == 2  # a skipped repeat stands for the item kept
+
+
+def test_importing_the_same_file_twice_adds_nothing_the_second_time(cli, tmp_path, todo_path):
+    path = write_import(tmp_path, [{"id": 1, "title": "eggs"}])
+    run(cli, "import", str(path))
+    assert run(cli, "import", str(path)) == ["imported 0, skipped 1 duplicates"]
+    assert len(load(todo_path)) == 1
+
+
+def test_import_takes_ids_above_the_archive_and_the_trash(cli, tmp_path, todo_path):
+    sides = SideFiles(todo_path, today=lambda: TODAY)
+    store = JsonStore(todo_path, today=lambda: TODAY)
+    store.add("a"), store.add("b")
+    first, second = store.load()
+    store.save([])
+    sides.archive.save([first.__class__(id=40, title="old")])
+    sides.trash.save([second.__class__(id=55, title="gone")])
+    run(cli, "import", str(write_import(tmp_path, [{"id": 1, "title": "new"}])))
+    assert load(todo_path)[0].id == 56
+
+
+@pytest.mark.parametrize(
+    "content",
+    [
+        "{not json",
+        '{"id": 1}',
+        '[{"id": 1}]',
+        '[{"id": "x", "title": "a"}]',
+        '[{"id": 1, "title": "a", "done_on": "soon"}]',
+        '[{"id": 1, "title": "ok"}, {"id": 2, "title": "bad", "priority": "urgent"}]',
+        '[{"id": 1, "title": "a", "colour": "red"}]',
+    ],
+)
+def test_import_of_a_malformed_file_exits_2_and_changes_nothing(cli, capsys, tmp_path, todo_path, content):
+    run(cli, "add", "milk")
+    before = todo_path.read_bytes()
+    err = fail(cli, capsys, 2, "import", str(write_import(tmp_path, content)))
+    assert err.startswith("todo: error: ")
+    assert todo_path.read_bytes() == before
+
+
+def test_import_of_a_missing_file_exits_2(cli, capsys, tmp_path):
+    err = fail(cli, capsys, 2, "import", str(tmp_path / "nope.json"))
+    assert "nope.json" in err
+
+
+def test_import_of_a_folder_exits_2(cli, capsys, tmp_path):
+    fail(cli, capsys, 2, "import", str(tmp_path))
+
+
+def test_import_refuses_a_file_over_the_size_cap(cli, capsys, tmp_path, monkeypatch, todo_path):
+    monkeypatch.setattr("todo.storage.json_file.MAX_FILE_BYTES", 64)
+    path = write_import(tmp_path, [{"id": i, "title": f"item {i}"} for i in range(20)])
+    err = fail(cli, capsys, 2, "import", str(path))
+    assert "too large" in err
+    assert "a file to import holds at most" in err
+    assert not todo_path.exists()
+
+
+def test_import_of_a_long_reference_chain_stays_linear(cli, tmp_path, todo_path):
+    rows = [{"id": i, "title": f"t{i}", "parent": i - 1 if i > 1 else None, "blocked_on": [i - 1] if i > 1 else []} for i in range(1, 2001)]
+    assert run(cli, "import", str(write_import(tmp_path, rows))) == ["imported 2000, skipped 0 duplicates"]
+    items = load(todo_path)
+    assert items[-1].parent == items[-2].id
+
+
+def test_import_of_a_reference_cycle_terminates(cli, tmp_path, todo_path):
+    rows = [{"id": 1, "title": "a", "parent": 2}, {"id": 2, "title": "b", "parent": 1}]
+    assert run(cli, "import", str(write_import(tmp_path, rows))) == ["imported 2, skipped 0 duplicates"]
+
+
+def test_import_into_a_bad_todo_file_exits_1_and_changes_nothing(cli, capsys, tmp_path, todo_path):
+    todo_path.write_text("{broken")
+    path = write_import(tmp_path, [{"id": 1, "title": "a"}])
+    err = fail(cli, capsys, 1, "import", str(path))
+    assert err.startswith("todo: error: ")
+    assert todo_path.read_text() == "{broken"
+
+
+def test_import_builds_its_save_from_a_single_load(cli, tmp_path, todo_path, monkeypatch):
+    # Two loads would let a writer between them move the ids the remap was computed for.
+    run(cli, "add", "milk")
+    rows = [{"id": 10, "title": "parent"}, {"id": 20, "title": "child", "parent": 10, "blocked_on": [10]}]
+    path = write_import(tmp_path, rows)
+    real_load = JsonStore.load
+    loads = []
+
+    def counting_load(self):
+        loads.append(1)
+        return real_load(self)
+
+    monkeypatch.setattr(JsonStore, "load", counting_load)
+    run(cli, "import", str(path))
+    monkeypatch.undo()
+    assert len(loads) == 1
+    items = {i.title: i for i in load(todo_path)}
+    assert (items["parent"].id, items["child"].id) == (2, 3)
+    assert (items["child"].parent, items["child"].blocked_on) == (2, [2])
+
+
+def test_import_of_repeated_ids_exits_2_and_changes_nothing(cli, capsys, tmp_path, todo_path):
+    run(cli, "add", "milk")
+    before = todo_path.read_bytes()
+    rows = [{"id": 1, "title": "a"}, {"id": 1, "title": "b"}]
+    err = fail(cli, capsys, 2, "import", str(write_import(tmp_path, rows)))
+    assert "repeated id 1" in err
+    assert todo_path.read_bytes() == before
+
+
+def test_import_of_a_done_row_without_done_on_counts_on_its_own_day(cli, tmp_path, todo_path):
+    row = {"id": 1, "title": "paid", "done": True, "updated_at": "2026-10-20T12:00:00+00:00"}
+    run(cli, "import", str(write_import(tmp_path, [row])))
+    (item,) = load(todo_path)
+    assert done_date(item, timezone.utc) == date(2026, 10, 20)
+
+
+def test_import_of_a_future_done_row_without_done_on_is_capped(cli, tmp_path, todo_path):
+    row = {"id": 1, "title": "paid", "done": True, "updated_at": "2026-11-20T12:00:00+00:00"}
+    run(cli, "import", str(write_import(tmp_path, [row])))
+    assert load(todo_path)[0].done_on == TODAY + timedelta(days=1)
+
+
+def test_import_keeps_the_real_day_of_done_work(cli, tmp_path, todo_path):
+    row = {"id": 1, "title": "paid", "done": True, "done_on": "2026-10-20"}
+    run(cli, "import", str(write_import(tmp_path, [row])))
+    assert done_date(load(todo_path)[0]) == date(2026, 10, 20)
+
+
+def test_import_of_a_done_row_with_no_date_at_all_counts_on_the_day_of_the_import(cli, tmp_path, todo_path):
+    run(cli, "import", str(write_import(tmp_path, [{"id": 1, "title": "paid", "done": True}])))
+    (item,) = load(todo_path)
+    assert item.done_on == TODAY
+    assert done_date(item, timezone.utc) == TODAY
+    assert run(cli, "streak")[0] == "current streak: 1 days"
+
+
+def test_import_of_a_no_free_id_error_exits_2_and_changes_nothing(cli, capsys, tmp_path, todo_path):
+    SideFiles(todo_path).history.raise_high_water(9007199254740992)
+    err = fail(cli, capsys, 2, "import", str(write_import(tmp_path, [{"id": 1, "title": "x"}])))
+    assert "no free id" in err
+    assert not todo_path.exists()
+
+
+def test_import_keeps_the_anchor_day_of_a_monthly_row(cli, tmp_path, todo_path):
+    row = {"id": 1, "title": "rent", "due": "2026-11-30", "every": "month", "anchor_day": 31}
+    run(cli, "import", str(write_import(tmp_path, [row])))
+    (item,) = load(todo_path)
+    assert (item.every, item.anchor_day) == ("month", 31)
+
+
+# --- todo import --format md FILE ---
+
+def write_md(tmp_path, text, name="in.md"):
+    path = tmp_path / name
+    path.write_text(text, encoding="utf-8")
+    return path
+
+
+def test_import_md_turns_checkbox_lines_into_items_and_counts_other_lines(cli, tmp_path, todo_path):
+    text = "# Groceries\n\n- [ ] milk\n* [x] eggs\n- [X] bread\nsome note\n- plain bullet\n-[ ] no space\n"
+    path = write_md(tmp_path, text)
+    assert run(cli, "import", "--format", "md", str(path)) == ["imported 3, skipped 0 duplicates, ignored 4 lines"]
+    milk, eggs, bread = load(todo_path)
+    assert [(i.id, i.title, i.done) for i in (milk, eggs, bread)] == [(1, "milk", False), (2, "eggs", True), (3, "bread", True)]
+    assert (milk.done_on, eggs.done_on, bread.done_on) == (None, TODAY, TODAY)
+    assert milk.created_on == TODAY
+
+
+def test_import_md_takes_ids_above_the_todo_file(cli, tmp_path, todo_path):
+    run(cli, "add", "first")
