+++ b/todo/cli/commands/import_cmd.py
+"""todo import [--format json|md] FILE: add the items of a JSON file shaped like the todo file, or of a Markdown checklist."""
+from pathlib import Path
+
+from todo.cli.errors import UsageError
+from todo.storage import StoreError
+from todo.storage.importer import import_items, read_import, read_markdown
+
+
+def register(parser) -> None:
+    parser.add_argument("--format", choices=("json", "md"), default="json", help="json (default): a file shaped like the todo file; md: `- [ ] title` lines")
+    parser.add_argument("file", type=Path, metavar="FILE", help="file to import")
+
+
+def run(args, ctx) -> None:
+    ignored = None
+    try:
+        if args.format == "md":
+            items, ignored = read_markdown(args.file, ctx.today)
+        else:
+            items = read_import(args.file, ctx.today)
+    except StoreError as e:
+        raise UsageError(str(e)) from None
+    try:
+        imported, skipped = import_items(ctx.store, items, ctx.today)
+    except StoreError:
+        raise  # a bad todo file: exit 1
+    except ValueError as e:  # no free id
+        raise UsageError(str(e)) from None
+    tail = "" if ignored is None else f", ignored {ignored} lines"
+    ctx.out(f"imported {imported}, skipped {skipped} duplicates{tail}")
