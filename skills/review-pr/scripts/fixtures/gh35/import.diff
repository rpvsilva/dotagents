diff --git a/todo/storage/importer.py b/todo/storage/importer.py
+++ b/todo/storage/importer.py
+"""Import items from a JSON file shaped like the todo file."""
+import dataclasses
+import re
+from datetime import date, datetime, timedelta
+from pathlib import Path
+
+from todo.storage.base import Store
+from todo.storage.json_file import MAX_FILE_BYTES, JsonFile
+from todo.storage.json_store import MAX_CLOCK_SKEW, item_from_row
+from todo.storage.model import Item, StoreError, local_date, new_series_id, normalize_title, utc_now
+
+
+# The most items one import reads. An imported item is saved with `done`, `due`, `updated_at`, `tags`,
+# `priority` and `created_on` always written, so its smallest saved row (indented as saved) takes about
+# 197 bytes, 199 with the comma and newline after it: a 16 MiB todo file holds no more than MAX_FILE_BYTES // 199 of them, so more can never be saved.
+# Without the cap a 16 MiB file of `- [ ] a` lines builds about 2 million items (GBs) before the save refuses.
+MAX_IMPORT_ITEMS = MAX_FILE_BYTES // 199
+
+
+def _too_many(path: Path) -> StoreError:
+    return StoreError(f"{path} holds too many items, an import takes at most {MAX_IMPORT_ITEMS}")
+
+
+def read_import(path: Path, today: date, now: datetime | None = None) -> list[Item]:
+    """The items in an import file, each through the todo file's row checks and caps.
+
+    `done_on` after `today` + 1 is capped there, as a load caps it. The file is untrusted: its size is
+    capped by `JsonFile`, and every later step is one pass. Raises StoreError on a bad file; nothing is read twice.
+    """
+    try:
+        rows = JsonFile(path, True, "file to import").read_json()
+    except OSError as e:
+        raise StoreError(f"cannot read {path}: {e.strerror or e}") from None
+    if rows is None:
+        raise StoreError(f"cannot read {path}: no such file")
+    if not isinstance(rows, list):
+        raise StoreError(f"invalid {path}, expected a list of items")
+    if len(rows) > MAX_IMPORT_ITEMS:
+        raise _too_many(path)
+    cap = today + timedelta(days=1)
+    latest = (now or utc_now()) + MAX_CLOCK_SKEW
+    items = []
+    ids = set()
+    for row in rows:
+        item = item_from_row(row, path, latest, lambda: cap)
+        if item.id in ids:
+            raise StoreError(f"{path}: repeated id {item.id}")
+        ids.add(item.id)
+        if item.done and item.done_on is None:
+            # insert restamps updated_at, so keep the day the row says it was done on; a row with no
+            # stamp either counts on the day of the import, as a Markdown `[x]` does
+            item.done_on = today if item.updated_at is None else min(local_date(item.updated_at), cap)
+        items.append(item)
+    return items
+
+
+_CHECKBOX = re.compile(r"[ \t]*[-*] \[([ xX])\](?:[ \t]+(.*))?")
+
+
+def read_markdown(path: Path, today: date) -> tuple[list[Item], int]:
+    """The items in a Markdown checklist and the number of other (non-blank) lines ignored.
+
+    A line `- [ ] title` or `* [x] title` (`x` or `X`) is an item; `[x]` items are done with `done_on`
+    `today`. A checkbox with no title is ignored. Ids are 1, 2, ... in file order (`import_items` gives
+    them new ones). The file is untrusted: its size is capped by `JsonFile`, and a file that is not UTF-8
+    text (or holds a NUL) raises StoreError, so a binary file imports nothing.
+    """
+    try:
+        data = JsonFile(path, True, "file to import").read_bytes()
+    except OSError as e:
+        raise StoreError(f"cannot read {path}: {e.strerror or e}") from None
+    if data is None:
+        raise StoreError(f"cannot read {path}: no such file")
+    try:
+        text = data.decode("utf-8-sig")
+    except UnicodeDecodeError:
+        raise StoreError(f"{path} is not a text file") from None
+    if "\0" in text:
+        raise StoreError(f"{path} is not a text file")
+    items = []
+    ignored = 0
+    for line in text.split("\n"):
+        line = line.rstrip("\r")  # only \n and \r\n end a line: a form feed or U+2028 stays in its title
+        match = _CHECKBOX.fullmatch(line)
+        title = normalize_title((match.group(2) or "").strip()) if match else ""
+        if not title:
+            ignored += bool(line.strip())
+            continue
+        done = match.group(1) != " "
+        if len(items) >= MAX_IMPORT_ITEMS:
+            raise _too_many(path)
+        items.append(Item(id=len(items) + 1, title=title, done=done, done_on=today if done else None))
+    return items, ignored
+
+
+def _key(item: Item) -> tuple[str, date | None]:
+    """Normalised title (exact otherwise) and due date: two items with the same key are duplicates."""
+    return normalize_title(item.title), item.due
+
+
+def import_items(store: Store, items: list[Item], today: date) -> tuple[int, int]:
+    """Add `items` to `store` in one save; return (imported, skipped duplicates).
+
+    An item whose title and due date match one in the store, or an earlier one in `items`, is skipped.
+    Imported items take new ids above everything (`Store.insert`), `created_on` today and a fresh stamp.
+    `parent` and `blocked_on` follow the new ids when they name an item in `items` (a skipped item stands
+    for the one it repeats), else they are dropped; each source series gets one fresh series id.
+    The duplicate check and the id remap run on the load the save is built from (`insert`'s `prepare`),
+    so a writer between two loads cannot leave references pointing at other items.
+    One pass over the items, a dict lookup per reference. Source ids are unique (`read_import`).
+    """
+    skipped = 0
+
+    def prepare(stored: list[Item], first_id: int) -> list[Item]:
+        nonlocal skipped
+        seen = {}
+        for item in stored:
+            seen.setdefault(_key(item), item.id)
+        new_id = {}  # source id -> id in the store
+        keep = []
+        for item in items:
+            key = _key(item)
+            if key not in seen:
+                seen[key] = first_id + len(keep)
+                keep.append(item)
+            new_id[item.id] = seen[key]
+        skipped = len(items) - len(keep)
+        series = {}
+        prepared = []
+        for item in keep:
+            mine = new_id[item.id]
+            blocked = [new_id[b] for b in item.blocked_on if b in new_id and new_id[b] != mine]
+            parent = new_id.get(item.parent)
+            prepared.append(
+                dataclasses.replace(
+                    item,
+                    created_on=None,
+                    parent=None if parent == mine else parent,
+                    blocked_on=list(dict.fromkeys(blocked)),
+                    series_id=None if item.series_id is None else series.setdefault(item.series_id, new_series_id()),
+                )
+            )
+        return prepared
+
+    saved = store.insert([], today, prepare)  # ValueError (no free id) is a caller's mistake: the command maps it to exit 2
+    return len(saved), skipped
