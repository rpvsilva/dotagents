+++ b/todo/cli/commands/copy_cmd.py
+"""todo copy ID: add an open copy of an item under a new id."""
+
+from todo.cli.errors import UsageError
+from todo.cli.refs import add_ref_argument, resolve
+from todo.storage import Item, StoreError
+from todo.storage.model import new_series_id
+
+
+def register(parser) -> None:
+    add_ref_argument(parser)
+
+
+def run(args, ctx) -> None:
+    source = resolve(ctx.store.load(), args.ref)
+    # Keeps title, tags, priority, due, due time, rule, project and estimate; every other field starts at its default.
+    copy = Item(
+        id=source.id,
+        title=source.title,
+        due=source.due,
+        due_time=source.due_time,
+        tags=list(source.tags),
+        priority=source.priority,
+        every=source.every,
+        anchor_day=source.anchor_day,
+        series_id=None if source.every is None else new_series_id(),
+        occurrence=None if source.every is None else 1,
+        project=source.project,
+        estimate=source.estimate,
+    )
+    try:
+        (new,) = ctx.store.insert([copy], ctx.today)
+    except StoreError:
+        raise  # a bad todo file: main exits 1
+    except ValueError as e:  # no free id
+        raise UsageError(str(e)) from None
+    ctx.out(f"copied {source.id} as {new.id}: {new.title}")
diff --git a/todo/cli/commands/template.py b/todo/cli/commands/template.py
+++ b/todo/cli/commands/template.py
+"""todo template [save NAME ID... | use NAME]: save items as a named template, or add open copies of one."""
+from todo.cli.errors import UsageError
+from todo.cli.refs import add_ref_argument, resolve_all
+from todo.storage import Item, StoreError
+from todo.storage.model import new_series_id, show
+from todo.storage.templates import MAX_ENTRIES, MAX_TEMPLATES, TemplateEntry, check_name, load_templates, save_templates
+
+
+def register(parser) -> None:
+    sub = parser.add_subparsers(dest="template_action")
+    save = sub.add_parser("save")
+    save.add_argument("name")
+    add_ref_argument(save, many=True)
+    use = sub.add_parser("use")
+    use.add_argument("name")
+
+
+def run(args, ctx) -> None:
+    file = ctx.sides.templates_file
+    action = args.template_action
+    if action is None:
+        for name in sorted(load_templates(file), key=lambda n: (n.casefold(), n)):
+            ctx.out(name)
+    elif action == "save":
+        _save(args, ctx, file)
+    else:
+        _use(args, ctx, file)
+
+
+def _save(args, ctx, file) -> None:
+    try:
+        name = check_name(args.name)
+    except ValueError as e:
+        raise UsageError(str(e)) from None
+    items = resolve_all(ctx.store.load(), args.ref)
+    if len(items) > MAX_ENTRIES:
+        raise UsageError(f"too many items ({len(items)}), a template holds at most {MAX_ENTRIES}")
+    templates = load_templates(file)
+    if name not in templates and len(templates) >= MAX_TEMPLATES:
+        raise UsageError(f"too many templates, at most {MAX_TEMPLATES}")
+    templates[name] = [
+        TemplateEntry(i.title, list(i.tags), i.priority, i.every, i.project, i.estimate) for i in items
+    ]
+    save_templates(file, templates)
+    ctx.out(f"saved template {name}: {len(items)} items")
+
+
+def _use(args, ctx, file) -> None:
+    templates = load_templates(file)
+    entries = templates.get(args.name)
+    if entries is None:
+        raise UsageError(f"no template {show(args.name)}")
+    items = [
+        Item(
+            id=0,
+            title=e.title,
+            tags=list(e.tags),
+            priority=e.priority,
+            due=ctx.today if e.every else None,
+            every=e.every,
+            series_id=new_series_id() if e.every else None,
+            occurrence=1 if e.every else None,
+            project=e.project,
+            estimate=e.estimate,
+        )
+        for e in entries
+    ]
+    try:
+        added = ctx.store.insert(items, ctx.today)
+    except StoreError:
+        raise  # a bad todo file: main exits 1
+    except ValueError as e:  # no free id
+        raise UsageError(str(e)) from None
+    for new in added:
+        ctx.out(f"added {new.id}: {new.title}")
