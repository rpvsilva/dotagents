+++ b/todo/storage/templates.py
+"""Templates: named lists of item shapes kept in `SideFiles.templates_file` as `{name: [entry, ...]}`.
+
+The file is untrusted: every row is checked once, in a single linear pass, and every error starts
+with `templates file: `.
+"""
+from dataclasses import dataclass, field
+
+from todo.storage.json_file import JsonFile
+from todo.storage.model import (
+    MAX_ESTIMATE,
+    StoreError,
+    normalize_project,
+    normalize_rule,
+    normalize_tags,
+    normalize_title,
+    parse_priority,
+    show,
+)
+
+LABEL = "templates file"
+MAX_NAME = 40
+MAX_TEMPLATES = 100
+MAX_ENTRIES = 100
+ENTRY_KEYS = ("title", "tags", "priority", "every", "project", "estimate")
+
+
+@dataclass
+class TemplateEntry:
+    title: str
+    tags: list[str] = field(default_factory=list)
+    priority: str | None = None
+    every: str | None = None
+    project: str | None = None
+    estimate: int | None = None
+
+
+def check_name(name) -> str:
+    """The template name, or ValueError: 1..MAX_NAME printable characters, not blank."""
+    if not isinstance(name, str):
+        raise ValueError(f"invalid template name {show(name)}")
+    if not 1 <= len(name) <= MAX_NAME or not name.strip() or not all(c.isprintable() for c in name):
+        raise ValueError(f"invalid template name {show(name)}, expected 1..{MAX_NAME} printable characters")
+    return name
+
+
+def _entry_from_row(raw, where: str) -> TemplateEntry:
+    if not isinstance(raw, dict):
+        raise ValueError(f"{where} is not an object")
+    unknown = raw.keys() - set(ENTRY_KEYS)
+    if unknown:
+        raise ValueError(f"{where} has unknown field {show(sorted(unknown)[0])}")
+    if "title" not in raw:
+        raise ValueError(f"{where} has no title")
+    estimate = raw.get("estimate")
+    if estimate is not None and (type(estimate) is not int or not 1 <= estimate <= MAX_ESTIMATE):
+        raise ValueError(f"{where}: invalid estimate {show(estimate)}")
+    project = raw.get("project")
+    every = raw.get("every")
+    tags = raw.get("tags", [])
+    if not isinstance(tags, list):
+        raise ValueError(f"{where}: tags is not a list")
+    if len(tags) > 1000:
+        raise ValueError(f"{where}: too many tags")
+    try:
+        return TemplateEntry(
+            title=normalize_title(raw["title"]),
+            tags=normalize_tags(tags),
+            priority=parse_priority(raw.get("priority")),
+            every=normalize_rule(every) if every is not None else None,
+            project=normalize_project(project) if project is not None else None,
+            estimate=estimate,
+        )
+    except ValueError as e:
+        raise ValueError(f"{where}: {e}") from None
+
+
+def _from_data(data) -> dict[str, list[TemplateEntry]]:
+    if not isinstance(data, dict):
+        raise ValueError("expected an object of template names")
+    if len(data) > MAX_TEMPLATES:
+        raise ValueError(f"too many templates ({len(data)}), at most {MAX_TEMPLATES}")
+    out = {}
+    for name, rows in data.items():
+        check_name(name)
+        if not isinstance(rows, list):
+            raise ValueError(f"template {show(name)} is not a list")
+        if not 1 <= len(rows) <= MAX_ENTRIES:
+            raise ValueError(f"template {show(name)} holds {len(rows)} items, expected 1..{MAX_ENTRIES}")
+        out[name] = [_entry_from_row(r, f"template {show(name)} item {n}") for n, r in enumerate(rows, 1)]
+    return out
+
+
+def _label(e: Exception) -> StoreError:
+    text = str(e)
+    return StoreError(text if text.startswith(f"{LABEL}: ") else f"{LABEL}: {text}")
+
+
+def load_templates(file: JsonFile) -> dict[str, list[TemplateEntry]]:
+    """Every template, checked; `{}` when the file is missing. StoreError (`templates file: ...`) when it is bad."""
+    try:
+        data = file.read_json()
+        return {} if data is None else _from_data(data)
+    except (StoreError, ValueError) as e:
+        raise _label(e) from None
+    except OSError as e:  # a directory or an unreadable file at the path
+        raise StoreError(f"{LABEL}: cannot read {file.path}: {e.strerror}") from None
+
+
+def save_templates(file: JsonFile, templates: dict[str, list[TemplateEntry]]) -> None:
+    """Write `templates`, refusing what a load would refuse (ValueError, nothing written)."""
+    rows = {n: [{k: getattr(e, k) for k in ENTRY_KEYS} for e in es] for n, es in templates.items()}
+    try:
+        _from_data(rows)
+    except ValueError as e:
+        raise ValueError(str(e)) from None
+    try:
+        file.write_json(rows)
+    except StoreError as e:
+        raise _label(e) from None
