diff --git a/README.md b/README.md
+++ b/README.md
+todo copy ID                        # add an open copy of an item under a new id, see Copy
+todo template [save NAME ID... | use NAME]   # list templates, save items as one, or add copies of one, see Templates
+### Copy
+
+`todo copy ID` adds an open copy of an item under a new id and prints `copied 1 as 5: write report`. The source is not changed.
+
+- The copy keeps the title, tags, priority, due date, due time, project, estimate and recurrence rule.
+- It drops everything else: notes, focus time, done state, doing, snooze, dependencies (`block`), parent, and the done date and done-time priority. So copying a done item gives an open one, and a copy of a subtask is a top-level item.
+- A recurring item is copied as the start of a new series: the copy has the same rule and due date, a new hidden series id and occurrence 1. It is not linked to the source's series, so `todo done` on one never touches the other.
+- The new id is above every id ever used (todo file, archive, trash and undo history), so it is never one that was used before.
+- An unknown id, or no free id, exits 2 and writes nothing.
+
+### Templates
+
+A template is a named list of item shapes, kept in `$TODO_FILE.templates`, next to the todo file. `todo template save NAME ID...` stores the title, tags, priority, recurrence rule, project and estimate of each item. It does not store due dates, due times or any other field.
+
+```
+$ todo template save weekly 1 2 3
+saved template weekly: 3 items
+$ todo template
+weekly
+$ todo template use weekly
+added 7: write report
+added 8: plan week
+added 9: clean desk
+```
+
+- `todo template` with no action lists the template names, one per line, in alphabetical order, ignoring letter case.
+- `save` with a name that exists replaces that template. A name is 1 to 40 printable characters. A store holds at most 100 templates, and a template at most 100 items.
+- `use NAME` adds one new open item per entry, each with a new id (above every id ever used), and prints `added ID: title` for each. Items get no due date, except recurring ones: a recurring copy is due today and starts a new series (occurrence 1). Nothing else carries over: no due time, notes, focus time, doing, snooze, dependencies or parent.
+- An unknown template name, a bad name, an unknown item id, or no free id exits 2 and writes nothing. A damaged templates file exits 1 with an error starting `templates file:`.
+- Templates are not synced: `todo sync` does not touch them.
+
+- Item ids go from 1 to 2**53 (9007199254740992); a file holding a larger id stops with an error, and `todo add`, `todo copy` and `todo template use` stop once that id is taken (exit 2).
diff --git a/tests/cli/test_cli_copy.py b/tests/cli/test_cli_copy.py
+++ b/tests/cli/test_cli_copy.py
+import os
+from datetime import date, datetime, time, timezone
+from pathlib import Path
+
+import pytest
+
+from todo.storage import FocusSession, Item, JsonStore, Note
+
+TODAY = date(2026, 11, 6)
+NOW = datetime(2026, 11, 6, 10, 0)
+STAMP = datetime(2026, 1, 1, tzinfo=timezone.utc)
+
+
+def run(cli, *argv):
+    return cli(*argv, today=TODAY, now=NOW)
+
+
+def store():
+    return JsonStore(Path(os.environ["TODO_FILE"]), today=lambda: TODAY)
+
+
+def fail(cli, capsys, code, *argv):
+    with pytest.raises(SystemExit) as exc:
+        run(cli, *argv)
+    assert exc.value.code == code
+    return capsys.readouterr().err
+
+
+def full_item(**over):
+    base = dict(
+        id=1,
+        title="write report",
+        done=True,
+        due=date(2026, 11, 20),
+        due_time=time(9, 30),
+        updated_at=STAMP,
+        tags=["work", "q4"],
+        priority="high",
+        done_on=date(2026, 11, 1),
+        done_priority="low",
+        created_on=date(2026, 10, 1),
+        snoozed_until=date(2026, 11, 10),
+        doing=True,
+        parent=2,
+        project="alpha",
+        estimate=90,
+        blocked_on=[2],
+        notes=[Note(STAMP, "a note")],
+        focus=[FocusSession(date(2026, 11, 2), 25)],
+    )
+    base.update(over)
+    return Item(**base)
+
+
+def seed(*items):
+    store().save(list(items))
+
+
+def copy_of(new_id):
+    return next(i for i in store().load() if i.id == new_id)
+
+
+def test_copy_prints_old_and_new_id_and_title(cli):
+    run(cli, "add", "milk")
+    assert run(cli, "copy", "1") == ["copied 1 as 2: milk"]
+
+
+def test_copy_leaves_the_source_untouched(cli):
+    seed(full_item(), Item(2, "parent"))
+    before = store().load()[0]
+    run(cli, "copy", "1")
+    assert store().load()[0] == before
+
+
+@pytest.mark.parametrize(
+    "field,value",
+    [
+        ("title", "write report"),
+        ("tags", ["work", "q4"]),
+        ("priority", "high"),
+        ("due", date(2026, 11, 20)),
+        ("due_time", time(9, 30)),
+        ("project", "alpha"),
+        ("estimate", 90),
+    ],
+)
+def test_copy_keeps_field(cli, field, value):
+    seed(full_item(), Item(2, "parent"))
+    run(cli, "copy", "1")
+    assert getattr(copy_of(3), field) == value
+
+
+@pytest.mark.parametrize(
+    "field,default",
+    [
+        ("done", False),
+        ("done_on", None),
+        ("done_priority", None),
+        ("snoozed_until", None),
+        ("doing", False),
+        ("parent", None),
+        ("blocked_on", []),
+        ("notes", []),
+        ("focus", []),
+    ],
+)
+def test_copy_drops_field(cli, field, default):
+    seed(full_item(), Item(2, "parent"))
+    run(cli, "copy", "1")
+    assert getattr(copy_of(3), field) == default
+
+
+def test_copy_is_stamped_and_created_today(cli):
+    seed(full_item())
+    run(cli, "copy", "1")
+    new = copy_of(2)
+    assert new.created_on == TODAY
+    assert new.updated_at > STAMP
+
+
+def test_copy_keeps_the_rule_as_a_new_series(cli):
+    run(cli, "add", "water", "--every", "week")
+    run(cli, "done", "1")  # item 2 is occurrence 2 of the series
+    run(cli, "copy", "2")
+    src, new = copy_of(2), copy_of(3)
+    assert new.every == "week"
+    assert new.anchor_day == src.anchor_day
+    assert new.occurrence == 1
+    assert new.series_id and new.series_id != src.series_id
+    assert new.due == src.due
+
+
+def test_copy_of_a_one_off_has_no_series(cli):
+    run(cli, "add", "milk")
+    run(cli, "copy", "1")
+    new = copy_of(2)
+    assert (new.every, new.series_id, new.occurrence) == (None, None, None)
+
+
+def test_copy_gets_an_id_above_a_trashed_id(cli, tmp_path):
+    run(cli, "add", "milk")
+    (tmp_path / "todo.json.trash").write_text('[{"id": 9, "title": "gone"}]')
+    assert run(cli, "copy", "1") == ["copied 1 as 10: milk"]
+
+
+def test_copy_gets_an_id_above_an_archived_id(cli, tmp_path):
+    run(cli, "add", "milk")
+    (tmp_path / "todo.json.archive").write_text('[{"id": 20, "title": "old", "done": true}]')
+    assert run(cli, "copy", "1") == ["copied 1 as 21: milk"]
+
+
+def test_copy_gets_an_id_above_the_history_high_water(cli, tmp_path):
+    run(cli, "add", "milk")
+    (tmp_path / "todo.json.history").write_text('{"high_water": 77, "steps": []}')
+    assert run(cli, "copy", "1") == ["copied 1 as 78: milk"]
+
+
+def test_copy_of_an_unknown_id_exits_2_and_writes_nothing(cli, capsys):
+    run(cli, "add", "milk")
+    before = Path(os.environ["TODO_FILE"]).read_bytes()
+    err = fail(cli, capsys, 2, "copy", "7")
+    assert err.startswith("todo: error:")
+    assert Path(os.environ["TODO_FILE"]).read_bytes() == before
+
+
+def test_copy_of_a_non_id_exits_2(cli, capsys):
+    fail(cli, capsys, 2, "copy", "x!")
+
+
+def test_copy_with_no_free_id_exits_2_and_writes_nothing(cli, capsys):
+    seed(full_item(id=1))
+    (Path(os.environ["TODO_FILE"] + ".history")).write_text(
+        '{"high_water": 9007199254740992, "steps": []}'
+    )
+    err = fail(cli, capsys, 2, "copy", "1")
+    assert err.startswith("todo: error: no free id")
+    assert [i.id for i in store().load()] == [1]
