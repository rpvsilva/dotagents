diff --git a/todo/cli/select.py b/todo/cli/select.py
+++ b/todo/cli/select.py
+    """Add --overdue, --snoozed, --tag, --priority, --project, --open/--done, --doing, --search, --sort and --archived to a command's parser."""
+    add_archived_argument(parser)
+
+
+def add_archived_argument(parser) -> None:
+    parser.add_argument("--archived", action="store_true", help="read the archive instead of the todo file")
+
+
+def load_items(args, ctx) -> list:
+    """The items a listing starts from: the todo file, or with --archived the archive (the todo file is not read)."""
+    return ctx.sides.archive.load() if args.archived else ctx.store.load()
