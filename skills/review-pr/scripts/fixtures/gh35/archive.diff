+import json
+import time as clock
+from datetime import date, datetime, time, timedelta, timezone
+
+import pytest
+
+from todo.storage import Item, JsonStore
+
+TODAY = date(2026, 11, 6)
+
+
+def stamp(day):
+    """A UTC stamp whose local date is `day`."""
+    return datetime.combine(day, time(12)).astimezone(timezone.utc)
+
+
+def write(path, *items):
+    JsonStore(path).save(list(items))
+
+
+def done(item_id, days_old, title=None):
+    return Item(item_id, title or f"t{item_id}", done=True, updated_at=stamp(TODAY - timedelta(days=days_old)))
+
+
+@pytest.fixture
+def paths(tmp_path):
+    return tmp_path / "todo.json", tmp_path / "todo.json.archive"
+
+
+def titles(path):
+    return [r["title"] for r in json.loads(path.read_text())]
+
+
+def test_archive_moves_done_items_older_than_30_days_and_counts_them(cli, paths):
+    todo, archive = paths
+    write(todo, done(1, 45), done(2, 31))
+    assert cli("archive", today=TODAY) == ["archived 2"]
+    assert titles(archive) == ["t1", "t2"]
+    assert json.loads(todo.read_text()) == []
+
+
+def test_archive_keeps_a_done_item_exactly_30_days_old(cli, paths):
+    todo, archive = paths
+    write(todo, done(1, 30))
+    assert cli("archive", today=TODAY) == ["archived 0"]
+    assert titles(todo) == ["t1"]
+    assert not archive.exists()
+
+
+def test_archive_takes_a_done_item_31_days_old(cli, paths):
+    todo, archive = paths
+    write(todo, done(1, 31))
+    assert cli("archive", today=TODAY) == ["archived 1"]
+    assert titles(archive) == ["t1"]
+
+
+def test_archive_leaves_open_items_however_old(cli, paths):
+    todo, archive = paths
+    write(todo, Item(1, "open", updated_at=stamp(TODAY - timedelta(days=400))), done(2, 40))
+    assert cli("archive", today=TODAY) == ["archived 1"]
+    assert titles(todo) == ["open"]
+    assert titles(archive) == ["t2"]
+
+
+def test_archive_with_nothing_to_move_prints_zero_and_writes_nothing(cli, paths):
