diff --git a/todo/cli/commands/archive.py b/todo/cli/commands/archive.py
+++ b/todo/cli/commands/archive.py
+"""todo archive: move done items last updated over 30 days ago to the archive file."""
+from datetime import timedelta
+
+from todo.storage import local_date
+
+ARCHIVE_AFTER = timedelta(days=30)
+
+
+def register(parser) -> None:
+    pass
+
+
+def _old(item, today) -> bool:
+    return item.done and item.updated_at is not None and today - local_date(item.updated_at) > ARCHIVE_AFTER
+
+
+def run(args, ctx) -> None:
+    archived = ctx.sides.archive.load()  # a bad archive file stops here, old items or not, before anything is written
+    items = ctx.store.load()
+    old = [i for i in items if _old(i, ctx.today)]
+    if old:
+        moving = {i.id for i in old}
+        # The archive first, then the todo file: a crash between the two duplicates, never loses.
+        ctx.sides.archive.save([i for i in archived if i.id not in moving] + old)
+        ctx.store.save([i for i in items if not _old(i, ctx.today)])
+    ctx.out(f"archived {len(old)}")
