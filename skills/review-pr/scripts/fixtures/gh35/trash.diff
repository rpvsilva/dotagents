+
+
+def test_ids_are_not_reused_while_the_item_is_in_the_trash(cli):
+    run(cli, "add", "a")
+    run(cli, "delete", "1")
+    run(cli, "add", "b")
+    assert run(cli, "list") == ["[ ] 2: b"]
+
+
+def test_trash_empty_never_lowers_a_higher_high_water_and_keeps_the_steps(cli, tmp_path):
+    (tmp_path / "todo.json.history").write_text(json.dumps({"high_water": 50, "steps": [{"x": 1}]}))
+    run(cli, "add", "a")
+    assert run(cli, "list") == ["[ ] 51: a"]
+    run(cli, "add", "b")
+    run(cli, "delete", "52")
