+    assert json.loads((tmp_path / "todo.json.history").read_text()) == {"high_water": 52, "steps": [{"x": 1}]}
+    run(cli, "delete", "51")
+    run(cli, "trash", "--empty")
+    assert json.loads((tmp_path / "todo.json.history").read_text())["high_water"] == 52
+    run(cli, "add", "c")
+    assert run(cli, "list") == ["[ ] 53: c"]
+
+
+def test_trash_empty_leaves_the_trash_when_the_history_cannot_be_written(cli, tmp_path, capsys):
+    run(cli, "add", "a")
+    run(cli, "delete", "1")
+    (tmp_path / "todo.json.history").write_text("not json")
+    fail(cli, capsys, 1, "trash", "--empty")
+    assert ids_in(tmp_path / "todo.json.trash") == [1]
+
+
+def test_trash_rejects_extra_words(cli, capsys):
+    fail(cli, capsys, 2, "trash", "now")
+
+
+def test_delete_loses_no_row_when_two_rows_share_an_id(cli, tmp_path):
+    run(cli, "add", "a")
+    path = todo_path(tmp_path)
+    row = json.loads(path.read_text())[0]
+    path.write_text(json.dumps([row, {**row, "title": "b"}]))
+    run(cli, "delete", "1")
