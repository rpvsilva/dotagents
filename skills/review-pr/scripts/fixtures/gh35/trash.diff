+
+
+def test_trash_empty_on_an_empty_trash_says_so(cli):
+    assert run(cli, "trash", "--empty") == ["emptied the trash: 0 items"]
+
+
+def test_ids_are_not_reused_after_the_trash_is_emptied(cli, tmp_path):
+    run(cli, "add", "a")
+    run(cli, "add", "b")
+    run(cli, "add", "c")
+    run(cli, "delete", "2", "3")
