+
+
+def rows(path):
+    return json.loads(path.read_text())
+
+
+def test_restore_brings_an_item_back_under_a_new_id(cli, tmp_path):
+    run(cli, "add", "milk")
+    run(cli, "delete", "1")
+    assert run(cli, "restore", "1") == ["restored 1 as 2: milk"]
