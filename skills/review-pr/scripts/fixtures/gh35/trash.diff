diff --git a/tests/cli/test_cli_trash_refs.py b/tests/cli/test_cli_trash_refs.py
+++ b/tests/cli/test_cli_trash_refs.py
+import json
+from datetime import date, datetime
+
+import pytest
+
+from todo.storage.model import MAX_ID
+
+TODAY = date(2026, 11, 6)
+NOW = datetime(2026, 11, 6, 10, 0)
+
+
+def run(cli, *argv):
+    return cli(*argv, today=TODAY, now=NOW)
+
+
+def fail(cli, capsys, code, *argv):
+    with pytest.raises(SystemExit) as exc:
+        run(cli, *argv)
+    assert exc.value.code == code
+    return capsys.readouterr().err
+
+
+def rows(path):
+    return json.loads(path.read_text())
+
+
+def test_restore_with_no_free_id_exits_2_and_writes_nothing(cli, tmp_path, capsys):
+    run(cli, "add", "a")
+    run(cli, "delete", "1")
+    trash = tmp_path / "todo.json.trash"
+    data = rows(trash)
+    data[0]["id"] = MAX_ID  # no id is left above it
+    trash.write_text(json.dumps(data))
+    before = trash.read_bytes()
+    err = fail(cli, capsys, 2, "restore", str(MAX_ID))
+    assert err.startswith("todo: error: no free id")
+    assert trash.read_bytes() == before
+    assert rows(tmp_path / "todo.json") == []
+
+
+def test_restore_keeps_every_field_of_a_fully_set_item(cli, tmp_path):
+    run(cli, "add", "full", "--due", "2026-11-09 09:30")
+    path = tmp_path / "todo.json"
+    row = rows(path)[0]
+    row.update(
+        {
+            "doing": True,
+            "snoozed_until": "2026-11-20",
+            "parent": 77,
+            "project": "home",
+            "estimate": 90,
+            "blocked_on": [78],
+            "focus": [{"on": "2026-11-05", "minutes": 25}],
+            "notes": [{"at": "2026-11-02T09:00:00+00:00", "text": "hi"}],
+            "created_on": "2026-10-01",
+        }
+    )
+    path.write_text(json.dumps([row]))
+    run(cli, "delete", "1")
+    run(cli, "restore", "1")
+    (new,) = rows(path)
+    assert new["id"] == 2
+    skip = ("id", "updated_at")
+    assert {k: v for k, v in new.items() if k not in skip} == {k: v for k, v in row.items() if k not in skip}
+    assert new["due_time"] == "09:30"
+
+
+@pytest.fixture
+def pair(cli):
+    run(cli, "add", "gather data")
+    run(cli, "add", "write report")
+    run(cli, "block", "2", "--on", "1")
+
+
+def test_a_deleted_blocker_stops_the_waiting_mark_and_blocking(cli, pair):
+    assert run(cli, "list")[1].endswith("waiting on 1")
+    assert "gather data" in run(cli, "next")[0]
+    run(cli, "delete", "1")
+    assert run(cli, "list") == ["[ ] 2: write report"]
+    assert "write report" in run(cli, "next")[0]
+    assert any("write report" in line for line in run(cli, "plan", "--hours", "1"))
+
+
+def test_a_child_lists_at_top_level_after_its_parent_is_deleted_and_after_restore(cli):
+    run(cli, "add", "trip")
+    run(cli, "add", "flights", "--parent", "1")
+    assert run(cli, "list")[1] == "  [ ] 2: flights"
+    run(cli, "delete", "1")
+    assert run(cli, "list") == ["[ ] 2: flights"]
+    run(cli, "restore", "1")
+    assert run(cli, "list") == ["[ ] 2: flights", "[ ] 3: trip"]
diff --git a/todo/cli/commands/delete.py b/todo/cli/commands/delete.py
+++ b/todo/cli/commands/delete.py
+"""todo delete ID...: move items to the trash."""
+from todo.cli.refs import add_ref_argument, resolve_all
+
+
+def register(parser) -> None:
+    add_ref_argument(parser, many=True)
+
+
+def run(args, ctx) -> None:
+    items = ctx.store.load()
+    chosen = resolve_all(items, args.ref)  # every ref first: one bad ref changes nothing
+    gone = {i.id for i in chosen}
+    moved = [i for i in items if i.id in gone]  # every row with a chosen id, so a duplicated id loses none
+    ctx.sides.trash.save(ctx.sides.trash.load() + moved)  # receiving file first: a crash duplicates, never loses
+    ctx.store.save([i for i in items if i.id not in gone])
+    for i in chosen:
+        ctx.out(f"deleted {i.id}: {i.title}")
diff --git a/todo/cli/commands/restore.py b/todo/cli/commands/restore.py
+++ b/todo/cli/commands/restore.py
+"""todo restore ID: bring an item back from the trash under a new id."""
+from todo.cli.errors import UsageError
+from todo.cli.refs import add_ref_argument, resolve
+from todo.storage import StoreError
+
+
+def register(parser) -> None:
+    add_ref_argument(parser)
+
+
+def run(args, ctx) -> None:
+    trashed = ctx.sides.trash.load()
+    item = resolve(trashed, args.ref)
+    try:
+        new = ctx.store.insert([item], ctx.today)[0]  # a new id above every id ever used; every other field kept
+    except StoreError:
+        raise  # a bad todo file: main exits 1
+    except ValueError as e:
+        if str(e).startswith("no free id"):
+            raise UsageError(str(e)) from None  # exit 2, as copy and template use
+        # a stored row the todo file would refuse (e.g. a parent equal to its new id): nothing is written
+        raise StoreError(f"{ctx.sides.trash.label}: cannot restore {item.id}: {e}") from None
+    # the trash last, after the todo file is saved: a crash duplicates, never loses
+    ctx.sides.trash.save([i for i in trashed if i is not item])
+    ctx.out(f"restored {item.id} as {new.id}: {new.title}")
diff --git a/todo/cli/commands/trash.py b/todo/cli/commands/trash.py
+++ b/todo/cli/commands/trash.py
+"""todo trash [--empty]: list the trash, or clear it for good."""
+from todo.cli.format import format_list_item
+
+
+def register(parser) -> None:
+    parser.add_argument("--empty", action="store_true", help="delete everything in the trash for good")
+
+
+def run(args, ctx) -> None:
+    trashed = ctx.sides.trash.load()
+    if args.empty:
+        if trashed:
+            # the high-water mark first: ids of items gone for good are never given out again
+            ctx.sides.history.raise_high_water(max(i.id for i in trashed))
+            ctx.sides.trash.save([])
+        ctx.out(f"emptied the trash: {len(trashed)} items")
+    elif not trashed:
+        ctx.out("trash is empty")
+    else:
+        for item in trashed:
+            ctx.out(format_list_item(item))
