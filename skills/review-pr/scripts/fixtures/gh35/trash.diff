diff --git a/README.md b/README.md
+++ b/README.md
+todo delete ID...                   # move items to the trash, see Trash
+todo restore ID                     # bring an item back from the trash under a new id, see Trash
+todo trash [--empty]                # list the trash, or empty it for good, see Trash
+- A trashed blocker does not block (see Trash). `todo restore` gives it a new id, so its old dependants are no longer waiting on it: they still list the old id (`todo show` prints it as `waits on`), and nothing points at the restored item until you run `todo block` again.
+### Trash
+
+`todo delete ID...` moves items to the trash, kept in `$TODO_FILE.trash` next to the todo file. It prints `deleted ID: title` for each item, in the order given. Every id is checked first: an unknown id exits 2 and nothing is deleted. A repeated id deletes the item once.
+
+```
+$ todo delete 4
+deleted 4: data
+$ todo trash
+[ ] 4: data
+$ todo restore 4
+restored 4 as 6: data
+```
+
+`todo trash` lists the trashed items as `todo list` lines (or `trash is empty`). `todo trash --empty` removes everything in the trash for good and prints `emptied the trash: N items`; it cannot be undone.
+
+`todo restore ID` brings a trashed item back and prints `restored OLD as NEW: title`. ID is an id from the trash list.
+
+- The restored item gets a new id, above every id ever used (todo file, archive, trash and undo history), so the old id is never given to a different item.
+- It keeps every other field: title, tags, priority, due date and time, recurrence rule and series, done state and done date, creation date, snooze, doing, parent, project, estimate, blockers, notes and focus time. Only its last-change stamp is renewed.
+- Other items' references are not rewritten. A subtask whose parent was trashed (or later restored under a new id) stays a top-level item; an item waiting on a trashed item stops waiting (see Dependencies). A restored item's own parent and blockers are kept as they were, so it nests under that parent again if the parent is still there.
+- A trashed item is gone from `todo list`, `todo search`, `todo remind`, `todo export` and the views, and never counts in streaks, XP, achievements, stats, review or burndown. Deleting a parent does not delete its children.
+- An unknown id, an empty trash, or no free id (ids are used up) exits 2 and writes nothing. A trashed row that the todo file would now refuse (a hand-edited trash file) exits 1 with `trash file: cannot restore ID: ...` and writes nothing.
+
+- Deletes do not sync: `todo sync` merges only the todo file, by id, and keeps no record of a deletion. A deleted item comes back, under its old id, on every sync while any synced copy (the remote included) still holds it, and each time your trash gains another copy. To get rid of it, delete it on every copy before the next sync. The trash itself is not synced.
diff --git a/tests/cli/test_cli_trash.py b/tests/cli/test_cli_trash.py
+++ b/tests/cli/test_cli_trash.py
+import json
+from types import SimpleNamespace
+from datetime import date, datetime, timezone
+
+import pytest
+
+from todo.insights import history_items
+from todo.storage import JsonStore
+from todo.storage.side_files import SideFiles
+
+TODAY = date(2026, 11, 6)
+NOW = datetime(2026, 11, 6, 10, 0)
+
+
+def run(cli, *argv):
+    return cli(*argv, today=TODAY, now=NOW)
+
+
+def fail(cli, capsys, code, *argv):
+    with pytest.raises(SystemExit) as exc:
+        run(cli, *argv)
+    assert exc.value.code == code
+    return capsys.readouterr().err
+
+
+def todo_path(tmp_path):
+    return tmp_path / "todo.json"
+
+
+def ids_in(path):
+    return [row["id"] for row in json.loads(path.read_text())] if path.exists() else []
+
+
+def test_delete_moves_one_item_to_the_trash(cli, tmp_path):
+    run(cli, "add", "milk")
+    run(cli, "add", "eggs")
+    assert run(cli, "delete", "1") == ["deleted 1: milk"]
+    assert run(cli, "list") == ["[ ] 2: eggs"]
+    assert run(cli, "trash") == ["[ ] 1: milk"]
+    assert ids_in(tmp_path / "todo.json.trash") == [1]
+
+
+def test_delete_moves_several_items_in_the_order_given(cli):
+    for title in ("a", "b", "c"):
+        run(cli, "add", title)
+    assert run(cli, "delete", "3", "1") == ["deleted 3: c", "deleted 1: a"]
+    assert run(cli, "list") == ["[ ] 2: b"]
+    assert sorted(run(cli, "trash")) == ["[ ] 1: a", "[ ] 3: c"]
+
+
+def test_delete_with_a_repeated_id_deletes_it_once(cli):
+    run(cli, "add", "milk")
+    assert run(cli, "delete", "1", "1") == ["deleted 1: milk"]
+
+
+def test_delete_with_an_unknown_id_changes_nothing_and_exits_2(cli, tmp_path, capsys):
+    run(cli, "add", "milk")
+    run(cli, "add", "eggs")
+    before = todo_path(tmp_path).read_bytes()
+    err = fail(cli, capsys, 2, "delete", "1", "9")
+    assert err == "todo: error: no item 9\n"
+    assert todo_path(tmp_path).read_bytes() == before
+    assert not (tmp_path / "todo.json.trash").exists()
+
+
+def test_delete_with_a_bad_reference_changes_nothing_and_exits_2(cli, tmp_path, capsys):
+    run(cli, "add", "milk")
+    before = todo_path(tmp_path).read_bytes()
+    fail(cli, capsys, 2, "delete", "1", "x")
+    assert todo_path(tmp_path).read_bytes() == before
+    assert not (tmp_path / "todo.json.trash").exists()
+
+
+def test_delete_without_an_id_exits_2(cli, capsys):
+    fail(cli, capsys, 2, "delete")
+
+
+def test_delete_keeps_the_todo_file_when_the_trash_cannot_be_written(cli, tmp_path, capsys):
+    run(cli, "add", "milk")
+    (tmp_path / "todo.json.trash").write_text("not json")
+    before = todo_path(tmp_path).read_bytes()
+    err = fail(cli, capsys, 1, "delete", "1")
+    assert err.startswith("todo: error: ")
+    assert todo_path(tmp_path).read_bytes() == before
+
+
+def test_delete_keeps_what_the_trash_already_holds(cli):
+    run(cli, "add", "a")
