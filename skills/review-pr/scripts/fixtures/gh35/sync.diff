+"""Where the remote lives: for now, another JSON file named by TODO_REMOTE."""
+import os
+from pathlib import Path
+
+from todo.storage import JsonStore, Store
+
+
+class RemoteNotConfigured(Exception):
+    """TODO_REMOTE is not set."""
+
+
+def remote_store(env=os.environ) -> Store:
+    path = env.get("TODO_REMOTE")
+    if not path:
+        raise RemoteNotConfigured("TODO_REMOTE is not set; point it at the remote todo file")
+    return JsonStore(Path(path))
diff --git a/todo/sync/sync.py b/todo/sync/sync.py
+++ b/todo/sync/sync.py
+"""todo sync: pull remote changes into the local store, then push the result."""
+from todo.storage import Store
+from todo.sync.merge import SyncResult, merge
+
+
+def sync(local: Store, remote: Store) -> SyncResult:
+    # Load both before writing anything, so a bad file on either side
+    # (StoreError) leaves both untouched.
+    local_items, remote_items = local.load(), remote.load()
+    result = merge(local_items, remote_items)
+    if result.pulled:
+        local.save(result.items)
+    if result.pushed:
+        remote.save(result.items)
+    return result
