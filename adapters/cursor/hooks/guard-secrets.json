{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      { "command": "\"$HOME/.agents/hooks/guard-secrets.sh\" && echo '{\"permission\":\"allow\"}'" }
    ],
    "beforeReadFile": [
      { "command": "\"$HOME/.agents/hooks/guard-secrets.sh\" && echo '{\"permission\":\"allow\"}'" }
    ]
  }
}
