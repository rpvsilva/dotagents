diff --git a/README.md b/README.md
index 0f386d4..a40f89f 100644
--- a/README.md
+++ b/README.md
@@ -7,6 +7,7 @@ A tiny command-line counter. It keeps named counts in one JSON file.
 ```
 tally add <name> [n]    add n (default 1) to a count
 tally list              print every count, highest first
+tally reset <name>      set a count back to 0
 ```
 
 The store is `~/.tally.json`, or the file `TALLY_FILE` names.
diff --git a/tally/cli.py b/tally/cli.py
index a7ddf63..491c8fa 100644
--- a/tally/cli.py
+++ b/tally/cli.py
@@ -1,4 +1,5 @@
-"""The `tally` commands: `add` and `list`."""
+"""The `tally` commands: `add`, `list` and `reset`."""
+import json
 import sys
 
 from tally import store
@@ -34,10 +35,25 @@ def list_counts(args):
     return 0
 
 
-COMMANDS = {"add": add, "list": list_counts}
+def reset(args):
+    if len(args) != 1:
+        return fail("usage: tally reset <name>")
+    name = args[0]
+    counts = store.load()
+    previous = counts[name]
+    if previous == 0:
+        print(f"{name} 0")
+        return 0
+    counts[name] = 0
+    store.path().write_text(json.dumps(counts, indent=2, sort_keys=True) + "\n")
+    print(f"{name} 0")
+    return 0
+
+
+COMMANDS = {"add": add, "list": list_counts, "reset": reset}
 
 
 def main(argv):
     if not argv or argv[0] not in COMMANDS:
-        return fail("usage: tally <add|list> ...")
+        return fail("usage: tally <add|list|reset> ...")
     return COMMANDS[argv[0]](argv[1:])
