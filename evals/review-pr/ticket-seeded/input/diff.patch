diff --git a/README.md b/README.md
index 0f386d4..ef4f6b9 100644
--- a/README.md
+++ b/README.md
@@ -7,6 +7,10 @@ A tiny command-line counter. It keeps named counts in one JSON file.
 ```
 tally add <name> [n]    add n (default 1) to a count
 tally list              print every count, highest first
+tally remove <name>     delete a count
+tally rename <old> <new>  give a count a new name
 ```
 
+A name is lowercase letters, digits and `-`.
+
 The store is `~/.tally.json`, or the file `TALLY_FILE` names.
diff --git a/tally/cli.py b/tally/cli.py
index a7ddf63..1c395d0 100644
--- a/tally/cli.py
+++ b/tally/cli.py
@@ -1,18 +1,27 @@
-"""The `tally` commands: `add` and `list`."""
+"""The `tally` commands: `add`, `list`, `remove` and `rename`."""
+import re
 import sys
 
 from tally import store
 
+NAME = re.compile(r"[a-z0-9-]+")
+
 
 def fail(message):
     print(f"tally: {message}", file=sys.stderr)
     return 1
 
 
+def valid_name(name):
+    return NAME.fullmatch(name) is not None
+
+
 def add(args):
     if not 1 <= len(args) <= 2:
         return fail("usage: tally add <name> [n]")
     name = args[0]
+    if not valid_name(name):
+        return fail(f"bad name: {name}")
     try:
         n = int(args[1]) if len(args) == 2 else 1
     except ValueError:
@@ -34,10 +43,33 @@ def list_counts(args):
     return 0
 
 
-COMMANDS = {"add": add, "list": list_counts}
+def remove(args):
+    if len(args) != 1:
+        return fail("usage: tally remove <name>")
+    counts = store.load()
+    counts.pop(args[0], None)
+    store.save(counts)
+    return 0
+
+
+def rename(args):
+    if len(args) != 2:
+        return fail("usage: tally rename <old> <new>")
+    old, new = args
+    counts = store.load()
+    if old not in counts:
+        print(f"tally: no count: {old}")
+        return 1
+    counts[new] = counts.pop(old)
+    store.save(counts)
+    print(f"{new} {counts[new]}")
+    return 0
+
+
+COMMANDS = {"add": add, "list": list_counts, "remove": remove, "rename": rename}
 
 
 def main(argv):
     if not argv or argv[0] not in COMMANDS:
-        return fail("usage: tally <add|list> ...")
+        return fail("usage: tally <add|list|remove|rename> ...")
     return COMMANDS[argv[0]](argv[1:])
